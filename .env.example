# Persistence provider. Defaults to mock when omitted, so local development
# never contacts Supabase unless this value is explicitly set to "supabase".
EXPERIENCE_DATA_PROVIDER=mock

# Required only when EXPERIENCE_DATA_PROVIDER=supabase. The anon key identifies
# the public Supabase client; it is not a privilege bypass. API calls use the
# caller's Supabase Auth JWT so PostgreSQL RLS remains effective.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only maintenance credential. Never prefix this key with NEXT_PUBLIC_,
# commit a value, use it from a Client Component, or use it for request access.
# Normal API requests deliberately use the anon key + caller JWT instead.
SUPABASE_SERVICE_ROLE_KEY=

# Minimal administrator sign-in. These values are server-only identifiers, not
# passwords and not public signup settings. The visible login name can stay
# `admin03`; Supabase Auth uses ADMIN_LOGIN_EMAIL only as an internal account
# identifier. Create this pre-provisioned user manually in Supabase Auth.
ADMIN_LOGIN_USERNAME=admin03
ADMIN_LOGIN_EMAIL=admin03@admin.local
# Used only by scripts/provision-admin.mjs to bind the pre-created Auth user.
ADMIN_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# Optional integration-test fixtures. Never put tokens into CI logs. These are
# only for an isolated non-production project with one scenario in each org.
# SUPABASE_TEST_ORG_A_ACCESS_TOKEN=
# SUPABASE_TEST_ORG_B_SCENARIO_ID=

# LLM Gateway. Default mock mode never makes a network request. LLM_API_KEY is
# server-only: never use NEXT_PUBLIC_ prefix, commit it, or print it in logs.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Optional for OpenAI/DeepSeek; required for Qwen because the endpoint depends
# on workspace/region. The value is an OpenAI-compatible base URL, without the
# /chat/completions suffix.
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2

# Speech Adapter. `mock` never contacts a vendor. `iflytek` uses the server-side
# real-time ASR large-model WebSocket; do not expose any of these as NEXT_PUBLIC_.
SPEECH_PROVIDER=mock
SPEECH_API_KEY=
SPEECH_API_SECRET=
SPEECH_APP_ID=
SPEECH_REGION=cn
# Optional endpoint override for an approved iFlytek deployment.
SPEECH_BASE_URL=
SPEECH_TIMEOUT_MS=30000
SPEECH_MAX_SECONDS=180
SPEECH_MAX_FILE_SIZE_MB=25
