# Production values belong only in the hosting platform's encrypted environment
# settings. Never commit this file with real credentials or copy development
# service-role keys into the production project.
EXPERIENCE_DATA_PROVIDER=supabase
NEXT_PUBLIC_APP_URL=https://xiaocui.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pre-provisioned internal administrator account; no public signup or email
# flow is enabled by this application.
ADMIN_LOGIN_USERNAME=admin03
ADMIN_LOGIN_EMAIL=admin03@admin.local
ADMIN_ORGANIZATION_ID=

# Explicit real providers only after staging acceptance. Keep mock during the
# first database/RLS pilot if model or audio acceptance is not in scope.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
SPEECH_PROVIDER=mock
SPEECH_API_KEY=
SPEECH_API_SECRET=
SPEECH_APP_ID=
SPEECH_REGION=cn

# Optional external error monitoring. This project does not send errors to a
# vendor until an approved server-only DSN/integration is implemented.
ERROR_MONITORING_PROVIDER=none
ERROR_MONITORING_DSN=
